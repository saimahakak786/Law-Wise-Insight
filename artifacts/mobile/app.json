{
  "expo": {
    "name": "LawVise",
    "slug": "law-wise-insight",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lawvise",
    "userInterfaceStyle": "light",
    "jsEngine": "hermes",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F0F4F5"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.saimahakak786.lawwise",
      "jsEngine": "hermes",
      "backgroundColor": "#F0F4F5"
    },
    "android": {
      "package": "com.saimahakak786.lawwise",
      "jsEngine": "hermes",
      "backgroundColor": "#F0F4F5",
      "displayName": "LawVise",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "lawvise"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "@clerk/expo",
        {
          "scheme": "lawvise"
        }
      ],
      [
        "expo-router",
        {
          "origin": "https://law-wise-insight.onrender.com"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow LawVise to access your microphone for voice dictation."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "packagingOptions": {
              "pickFirst": [
                "META-INF/versions/9/OSGI-INF/MANIFEST.MF"
              ]
            },
            "gradleProperties": {
              "org.gradle.jvmargs": "-Xmx4g -XX:MaxMetaspaceSize=512m -XX:+HeapDumpOnOutOfMemoryError"
            }
          }
        }
      ],
      [
        
        [
  "expo-notifications",
  {
    "sounds": [
      "./assets/images/court_alarm.mp3"
    ]
  }
]

      
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "androidStatusBar": {
      "backgroundColor": "#F0F4F5",
      "barStyle": "dark-content"
    },
    "backgroundColor": "#F0F4F5",
    "extra": {
      "EXPO_PUBLIC_API_URL": "https://law-wise-insight.onrender.com",
      "EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY": "pk__test_b3JpZW50ZWQtZWxlcGhhbnQtNDA5OC5jbGVyay5hY2NvdW50cy5kZXYk",
      "eas": {
        "projectId": "992c7d24-c74c-4481-98df-31c2575db0f5"
      }
    }
  }
}
