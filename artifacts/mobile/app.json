{
  "expo": {
    "name": "LawWise",
    "slug": "law-wise-insight",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#070D24"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.saimahakak.lawwise"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-secure-store",
      "@clerk/expo",
      [
        "expo-router",
        {
          https://law-wise-insight.onrender.com

        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "packagingOptions": {
              "pickFirst": [
                "META-INF/versions/9/OSGI-INF/MANIFEST.MF"
              ]
            }
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "androidStatusBar": {
      "backgroundColor": "#070D24",
      "barStyle": "light-content"
    },
    "backgroundColor": "#070D24",
    "extra": {
      "eas": {
        "projectId": "992c7d24-c74c-4481-98df-31c2575db0f5"
      }
    }
  }
}
